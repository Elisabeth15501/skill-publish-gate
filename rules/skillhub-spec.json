{
  "version": "3.0.0",
  "description": "Skill 发布门禁规范库 v3.0.0（skill 代码安全 + SkillHub/ClawHub/ima 平台规范）。数据驱动：规则写在本文件，gate.py 不含词表；新增平台只需加 platform_profiles。",
  "spec": {
    "frontmatter": {
      "required": [
        "slug",
        "version",
        "displayName"
      ],
      "recommended": [
        "name",
        "description",
        "summary",
        "tags"
      ],
      "slug_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "slug_min": 2,
      "slug_max": 128,
      "semver_pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "forbidden_files": [
      ".gitignore",
      ".nojekyll",
      "LICENSE",
      "LICENSE.md",
      "LICENSE.txt",
      ".github",
      ".git",
      "__pycache__",
      ".clawhubignore",
      ".pytest_cache",
      ".allure-results",
      "allure-results",
      ".github_token",
      ".workbuddy",
      ".env",
      ".venv",
      "node_modules"
    ],
    "github_allowed_files": [
      "LICENSE",
      "LICENSE.md",
      "LICENSE.txt",
      ".github",
      ".gitignore"
    ],
    "forbidden_globs": [
      "*.pyc",
      "*.pyo",
      "*.class",
      ".DS_Store",
      "*.egg-info"
    ],
    "bundle": {
      "warn_file_count": 100,
      "max_file_count": 1000,
      "warn_total_bytes": 10485760,
      "max_total_bytes": 52428800
    },
    "version_locations": [
      "SKILL.md",
      "config.json",
      "metadata.json",
      "CHANGELOG.md"
    ],
    "artifact_dirs": [
      "allure-results",
      ".pytest_cache",
      "data",
      "__pycache__"
    ],
    "platform_profiles": {
      "ima": {
        "display_name": "ima（腾讯 ima 知识库）",
        "frontmatter_required": [
          "name",
          "displayName",
          "description",
          "version",
          "trigger_keywords",
          "reference",
          "disclaimer"
        ],
        "forbidden_files": [
          "_meta.json"
        ],
        "ascii_quotes_only": true,
        "ascii_filename_only": true,
        "max_trigger_keywords": 5,
        "notes": "ima 包规范：frontmatter 七字段齐全、包内不得含 _meta.json（由平台生成）、字符串只用 ASCII 直引号、文件名纯 ASCII、trigger_keywords ≤5 条。来源为 v2 方案复盘记录。",
        "unknown": "若平台口径与此处不符，改本段即可，不涉及 gate.py 代码。"
      }
    }
  },
  "rules": [
    {
      "id": "RED-NET-001",
      "clause": "第6.2条（禁止发布违法违规内容）/第2.2条（内容审核红线）",
      "category": "CONTENT",
      "severity": "critical",
      "redline": true,
      "authority_type": "platform_policy",
      "scan_targets": [
        "docs",
        "scripts"
      ],
      "patterns": [
        "翻墙",
        "翻牆",
        "科学上网",
        "科學上網",
        "梯子",
        "GFW",
        "突破网络",
        "突破防火"
      ],
      "self_describing_markers": [
        "网络规避",
        "敏感词",
        "合规"
      ],
      "description": "命中网络规避敏感词，将触发 SkillHub 内容合规审核拒绝（下架风险）。删除相关表述，不要在任何语言（文档/注释/输出字符串）中出现。",
      "legal_source": "SkillHub 内容审核红线（三线并行：内容合规过滤）",
      "platform_downgrade": {
        "clawhub": "medium"
      }
    },
    {
      "id": "RED-NET-002",
      "clause": "第6.2条（禁止发布违法违规内容）/第2.2条（内容审核红线）",
      "category": "CONTENT",
      "severity": "critical",
      "redline": true,
      "authority_type": "platform_policy",
      "scan_targets": [
        "docs",
        "scripts"
      ],
      "patterns": [
        "shadowsocks",
        "v2ray",
        "clash",
        "trojan",
        "wireguard",
        "ssr",
        "vless",
        "vmess"
      ],
      "self_describing_markers": [
        "网络规避",
        "敏感词",
        "合规",
        "代理工具"
      ],
      "description": "命中代理工具同族词（shadowsocks/v2ray/clash/trojan 等），属网络规避敏感家族，会触发内容审核拒绝。除非技能本身合法且已获授权，否则删除。",
      "legal_source": "SkillHub 内容审核红线",
      "platform_downgrade": {
        "clawhub": "medium"
      }
    },
    {
      "id": "RED-NET-003",
      "clause": "第6.2条（禁止发布违法违规内容）/第2.2条（内容审核红线）",
      "category": "CONTENT",
      "severity": "high",
      "redline": true,
      "authority_type": "platform_policy",
      "scan_targets": [
        "docs",
        "scripts"
      ],
      "patterns": [
        "机场",
        "节点订阅",
        "订阅链接",
        "vpn 节点",
        "翻墙节点"
      ],
      "exclude_patterns": [
        "机场代码",
        "国际机场",
        "航空"
      ],
      "self_describing_markers": [
        "网络规避",
        "敏感词",
        "合规"
      ],
      "description": "「机场 / 节点订阅」在中文语境通常指代理服务，属敏感家族。确认无规避网络管理表述后再发布。",
      "legal_source": "SkillHub 内容审核红线",
      "platform_downgrade": {
        "clawhub": "medium"
      }
    },
    {
      "id": "RED-NET-004",
      "clause": "第6.2条（禁止发布违法违规或规避网络管理限制的内容）",
      "category": "CONTENT",
      "severity": "high",
      "redline": true,
      "authority_type": "platform_policy",
      "scan_targets": [
        "docs",
        "scripts"
      ],
      "patterns": [
        "提升海外源可达性",
        "走通后.*恢复",
        "解决.*访问限制",
        "访问限制.*(绕过|解除|突破)",
        "解锁.*网络",
        "恢复.*访问"
      ],
      "description": "把功能描述成「解决某类访问限制 / 提升海外源可达性 / 走通后 XX 即可恢复」会被判为规避手段叙事。应改为「源不可达 → 降级到国内源 + 离线快照 + 如实标注」的降级路径。",
      "legal_source": "SkillHub 内容审核红线（功能合法 ≠ 文档合规）",
      "platform_downgrade": {
        "clawhub": "medium"
      }
    },
    {
      "id": "RED-AD-001",
      "clause": "第6.2条（禁止发布违法违规内容：广告法绝对化用语）",
      "category": "CONTENT",
      "severity": "high",
      "redline": false,
      "authority_type": "platform_policy",
      "scan_targets": [
        "docs"
      ],
      "patterns": [
        "最好",
        "最佳",
        "第一",
        "唯一",
        "全网唯一",
