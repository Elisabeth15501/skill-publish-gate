        "clawhub": "medium"
      }
    },
    {
      "id": "AGENT-MEMORY-001",
      "clause": "第5.1条（不得篡改用户数据）/第5.4条（安全风险）",
      "category": "AGENTIC",
      "severity": "critical",
      "redline": true,
      "authority_type": "platform_policy",
      "scan_targets": [
        "docs",
        "scripts"
      ],
      "origin": "v1.5.0 C4 agentic 类目——记忆投毒",
      "patterns": [
        "(记住|记录|写入|保存|存下)[^。\\n]{0,10}(用户|使用者)[^。\\n]{0,10}(偏好|身份|信息|习惯|姓名|邮箱)",
        "(每次|以后|后续)[^。\\n]{0,8}(都|一律|全部)[^。\\n]{0,10}(告诉|告知|汇报|上报)[^。\\n]{0,10}(用户|主人|雇主)",
        "永久(性)?(记住|保存|存储|写入)[^。\\n]{0,8}(会话|对话)",
        "without\\s+(the\\s+)?user'?s?\\s+(consent|knowledge|approval)",
        "记住这条(规则|指令|要求)[^。\\n]{0,10}(优先|高于|覆盖)"
      ],
      "use_global_meta_markers": false,
      "self_describing_markers": [
        "防护",
        "防御",
        "检测",
        "防止",
        "红线",
        "禁止",
        "不得",
        "审计",
        "排查",
        "风险",
        "说明",
        "解释"
      ],
      "description": "命中 agentic 记忆投毒特征：指示宿主跨会话永久记住用户身份/偏好，或要求每次都向第三方（用户本人以外的收信人）汇报。记忆投毒是 skill 特有的攻击面——通用代码扫描器不读 SKILL.md，抓不到这类指令式风险。删除该指令，或改为会话内临时状态。",
      "platform_downgrade": {
        "clawhub": "high"
      },
      "clause_note": "与 SEC-PERSIST-001 的分工：那条抓「实际写持久化文件」，这条抓「指令式要求记住/上报」——一个抓代码，一个抓文档",
      "exclude_patterns": [
        "不(会|得|要|应|可|再|能)?\\s*(持久化\\s*)?(保存|记录|写入|存储|记住|留存)",
